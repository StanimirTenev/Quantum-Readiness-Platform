# Copy this file to .env (in this same directory) and fill in real values
# before exposing this stack outside a trusted local network. .env is
# git-ignored -- never commit real secrets. docker compose reads .env
# automatically from this directory.

# Shared API key required on every gateway route except /health. Leave unset
# for local-only use; required in practice once the stack is reachable from
# outside this machine. Generate one with: openssl rand -hex 32
QRP_API_KEY=

# Public Demo Safety Mode: set to "true" to restrict the gateway to a fixed
# allowlist (browsing + the built-in demo dataset only) -- blocks arbitrary
# scan ingest and other mutations. Independent of QRP_API_KEY -- use this for
# an unattended public demo instance visitors browse without a key.
QRP_DEMO_MODE=

# PostgreSQL credentials (used by inventory-service and workflow-service).
# The qrp/qrp/qrp defaults are fine for a local docker compose up but MUST be
# changed before deploying anywhere reachable from the internet.
POSTGRES_USER=qrp
POSTGRES_PASSWORD=qrp
POSTGRES_DB=qrp

# Required only for `docker compose --profile public up` (the Caddy reverse
# proxy). Must be a real domain with a DNS A/AAAA record pointing at this
# host -- Let's Encrypt cannot issue a certificate for "localhost" or a bare
# IP. Use a subdomain (e.g. demo.example.com) if the root domain is reserved
# for a separate landing/download page.
DOMAIN=

# Restrict the gateway's CORS policy to the real domain once one is in use
# (defaults to "*", fine for local dev, too permissive for a public
# deployment). Comma-separated if serving more than one origin.
CORS_ALLOW_ORIGINS=https://demo.example.com
